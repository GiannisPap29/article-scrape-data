# Copy to .env and fill in DRIVE_FOLDER_ID. Everything else has a sensible default.

# --- Google Drive inbox (the MEDIUM folder with your saved links) ---
DRIVE_FOLDER_ID=your-google-drive-folder-id
# Optional: by default MEDIUM_ARCHIVED / MEDIUM_FAILED / MEDIUM_BACKUPS inside the inbox are used (created if missing).
DRIVE_ARCHIVE_FOLDER_ID=
DRIVE_FAILED_FOLDER_ID=
DRIVE_BACKUP_FOLDER_ID=
DRIVE_BACKUP_FILE_NAME=library.db
GOOGLE_OAUTH_CLIENT_FILE=./data/oauth/google-client.json
GOOGLE_OAUTH_TOKEN_FILE=./data/oauth/google-token.json

# --- Scraping ---
# chrome = your installed Chrome; chromium = Playwright's own (make setup downloads it).
BROWSER=chrome
# false = show the browser window while scraping.
HEADLESS=false
# Attach to an already running Chrome instead (e.g. http://127.0.0.1:9222).
CONNECT_URL=
# Freedium mirror tried first, plus optional comma-separated fallback mirrors.
FREEDIUM_URL=https://freedium-mirror.cfd/
FREEDIUM_FALLBACK_URLS=
# Pause between articles in ms: fixed (5000) or random range (3000-8000).
SCRAPE_DELAY_MS=3000-8000
# Failed URLs are retried with backoff (15m, 30m, 1h, ... max 12h) up to this many times.
MAX_SCRAPE_ATTEMPTS=5

# --- Local AI (Ollama) ---
RAG_MODEL=gemma3:1b
RAG_EMBED_MODEL=embeddinggemma

# --- Paths (defaults shown) ---
OUTPUT_DIR=./data/output
LIBRARY_DB_FILE=./data/library.db
DEBUG_DIR=./data/debug
