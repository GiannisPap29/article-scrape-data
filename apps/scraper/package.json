{
  "name": "web-scrapper",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "install:browsers": "playwright install chromium",
    "scrape": "npm run build && node --no-warnings --enable-source-maps dist/scraper/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --no-warnings \"dist/tests/**/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^24.0.10",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "playwright": "1.59.1"
  }
}
